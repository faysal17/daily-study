# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, used by the daily cron job. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the Vercel Cron endpoint. Generate any long random string.
# Vercel automatically sends this as `Authorization: Bearer <CRON_SECRET>` on cron invocations.
CRON_SECRET=change-me-to-a-long-random-string

# Timezone used for "today" and the overdue rollover. IANA name.
APP_TIMEZONE=Asia/Dhaka
